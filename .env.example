# TaskMatrix — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------

# Base URL for the mock REST API (JSON Server)
# Local development: http://localhost:3001
# Staging:           https://taskmatrix-api-staging.railway.app
# Production:        https://taskmatrix-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:3001

# ------------------------------------------------------------
# Firebase Configuration
# ------------------------------------------------------------

# Replace these values with your Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------

# Application environment — gates debug tooling and verbose logging
# Values: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Application base URL — used for OG meta tags and absolute URL generation
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Feature Flags (optional — defaults to false if not set)
# ------------------------------------------------------------

# Enable the AI task suggestion feature (Phase 3)
NEXT_PUBLIC_ENABLE_AI_SUGGESTIONS=false

# Enable voice notes feature (Phase 3)
NEXT_PUBLIC_ENABLE_VOICE_NOTES=false

# Enable Slack integration (Phase 3)
NEXT_PUBLIC_ENABLE_SLACK=false

# ------------------------------------------------------------
# Analytics (future — not used in Sprint 13-15)
# ------------------------------------------------------------

# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
