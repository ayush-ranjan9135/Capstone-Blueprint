    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.10.1",
